import { Tabs } from 'expo-router'
import { Cpu, Flower2, Home, Lightbulb, Settings } from 'lucide-react-native'
import React, { useEffect, useRef } from 'react'
import { Dimensions, Platform, StyleSheet, TouchableOpacity, View } from 'react-native'
import Animated, { 
  useAnimatedStyle, 
  useSharedValue,
  withSpring,
  withTiming,
  Easing
} from 'react-native-reanimated'
import { useSafeAreaInsets } from 'react-native-safe-area-context'

const { width: SCREEN_WIDTH } = Dimensions.get('window')

const THEME = {
  paper: '#fdfcf8',
  paperDark: '#f0efea',
  ink: '#14281d',
  forest: '#4a795f',
  forestLight: '#6a9b7f',
  inkLight: '#3a5a40',
  inkMuted: '#8a9a90',
  orchidMain: '#9f5f80',
  gold: '#d4a574'
}

// Tab configuration
const TAB_COUNT = 5
const HOME_INDEX = 2
const TAB_BAR_PADDING = 24
const INDICATOR_SIZE = 56
const HOME_INDICATOR_SIZE = 64

// ─────────────────────────────────────────────────────────────────────────────
// Floating Pill Navbar - Modern botanical-inspired design with sliding indicator
// ─────────────────────────────────────────────────────────────────────────────
function CustomTabBar({ state, descriptors, navigation }: any) {
  const insets = useSafeAreaInsets()
  const tabWidth = (SCREEN_WIDTH - TAB_BAR_PADDING * 2 - 16) / TAB_COUNT
  
  // Animated indicator position
  const indicatorX = useSharedValue(state.index * tabWidth)
  const prevIndex = useRef(state.index)
  
  useEffect(() => {
    // Animate the indicator to new position
    indicatorX.value = withSpring(state.index * tabWidth, {
      damping: 18,
      stiffness: 180,
      mass: 0.8
    })
    prevIndex.current = state.index
  }, [state.index, tabWidth])
  
  const indicatorStyle = useAnimatedStyle(() => {
    const isHome = Math.round(indicatorX.value / tabWidth) === HOME_INDEX
    const size = isHome ? HOME_INDICATOR_SIZE : INDICATOR_SIZE
    const centerOffset = (tabWidth - size) / 2
    
    return {
      transform: [
        { translateX: indicatorX.value + centerOffset },
        { translateY: isHome ? -12 : 0 }
      ],
      width: withTiming(size, { duration: 200 }),
      height: withTiming(size, { duration: 200 }),
      borderRadius: withTiming(size / 2, { duration: 200 }),
      backgroundColor: isHome ? THEME.orchidMain : THEME.forest
    }
  })

  return (
    <View style={[styles.tabBarWrapper, { paddingBottom: Math.max(insets.bottom, 12) }]}>
      <View style={styles.tabBarPill}>
        {/* Sliding indicator */}
        <Animated.View style={[styles.slidingIndicator, indicatorStyle]} />
        
        {/* Tab buttons */}
        {state.routes.map((route: any, index: number) => {
          const { options } = descriptors[route.key]
          const isFocused = state.index === index
          const isHome = index === HOME_INDEX

          const onPress = () => {
            const event = navigation.emit({
              type: 'tabPress',
              target: route.key,
              canPreventDefault: true
            })

            if (!isFocused && !event.defaultPrevented) {
              navigation.navigate(route.name)
            }
          }

          return (
            <TabButton
              key={route.key}
              icon={options.tabBarIcon}
              label={options.title}
              isFocused={isFocused}
              isHome={isHome}
              onPress={onPress}
              tabWidth={tabWidth}
            />
          )
        })}
      </View>
    </View>
  )
}

// Individual tab button with smooth animations
function TabButton({
  icon,
  label,
  isFocused,
  isHome,
  onPress,
  tabWidth
}: {
  icon: (props: { color: string; focused: boolean }) => React.ReactNode
  label: string
  isFocused: boolean
  isHome: boolean
  onPress: () => void
  tabWidth: number
}) {
  const animatedIconStyle = useAnimatedStyle(() => ({
    transform: [
      { scale: withSpring(isFocused ? 1.1 : 1, { damping: 12, stiffness: 180 }) },
      { translateY: withSpring(isFocused && isHome ? -12 : isFocused ? -2 : 0, { damping: 15, stiffness: 200 }) }
    ]
  }))
  
  const animatedLabelStyle = useAnimatedStyle(() => ({
    opacity: withTiming(isFocused ? 1 : 0, { duration: 150 }),
    transform: [
      { translateY: withTiming(isFocused ? 0 : 8, { duration: 150 }) },
      { scale: withSpring(isFocused ? 1 : 0.8, { damping: 15 }) }
    ]
  }))

  const iconColor = isFocused ? '#fff' : THEME.inkMuted

  return (
    <TouchableOpacity 
      style={[styles.tabButton, { width: tabWidth }]} 
      onPress={onPress} 
      activeOpacity={0.7}
    >
      {/* Icon */}
      <Animated.View style={[styles.tabIconWrapper, animatedIconStyle]}>
        {icon({ color: iconColor, focused: isFocused })}
      </Animated.View>
      
      {/* Label - only show when focused */}
      <Animated.Text
        style={[
          styles.tabLabel,
          { color: isFocused ? THEME.ink : THEME.inkMuted },
          animatedLabelStyle
        ]}
        numberOfLines={1}
      >
        {label}
      </Animated.Text>
    </TouchableOpacity>
  )
}

export default function DashboardLayout() {
  return (
    <Tabs
      tabBar={(props) => <CustomTabBar {...props} />}
      screenOptions={{
        headerShown: false,
        animation: 'shift'
      }}
    >
      <Tabs.Screen
        name='garden'
        options={{
          title: 'Garden',
          tabBarIcon: ({ color, focused }) => (
            <Flower2 size={22} color={color} strokeWidth={focused ? 2.5 : 1.8} />
          )
        }}
      />
      <Tabs.Screen
        name='expert'
        options={{
          title: 'Insights',
          tabBarIcon: ({ color, focused }) => (
            <Lightbulb size={22} color={color} strokeWidth={focused ? 2.5 : 1.8} />
          )
        }}
      />
      <Tabs.Screen
        name='index'
        options={{
          title: 'Home',
          tabBarIcon: ({ color, focused }) => (
            <Home size={22} color={color} strokeWidth={focused ? 2.5 : 1.8} />
          )
        }}
      />
      <Tabs.Screen
        name='devices'
        options={{
          title: 'Devices',
          tabBarIcon: ({ color, focused }) => (
            <Cpu size={22} color={color} strokeWidth={focused ? 2.5 : 1.8} />
          )
        }}
      />
      <Tabs.Screen
        name='store'
        options={{
          title: 'Settings',
          tabBarIcon: ({ color, focused }) => (
            <Settings size={22} color={color} strokeWidth={focused ? 2.5 : 1.8} />
          )
        }}
      />
    </Tabs>
  )
}

const styles = StyleSheet.create({
  tabBarWrapper: {
    position: 'absolute',
    bottom: 0,
    left: 0,
    right: 0,
    alignItems: 'center',
    paddingHorizontal: TAB_BAR_PADDING
  },
  tabBarPill: {
    flexDirection: 'row',
    alignItems: 'flex-end',
    justifyContent: 'center',
    paddingHorizontal: 8,
    paddingVertical: 10,
    paddingTop: 18,
    backgroundColor: 'rgba(253, 252, 248, 0.98)',
    borderRadius: 32,
    borderWidth: 1,
    borderColor: 'rgba(74, 121, 95, 0.08)',
    shadowColor: THEME.ink,
    shadowOffset: { width: 0, height: 10 },
    shadowOpacity: 0.15,
    shadowRadius: 30,
    elevation: 16,
    overflow: 'visible'
  },
  slidingIndicator: {
    position: 'absolute',
    top: 8,
    left: 8,
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 4 },
    shadowOpacity: 0.25,
    shadowRadius: 12,
    elevation: 8
  },
  tabButton: {
    alignItems: 'center',
    justifyContent: 'flex-end',
    paddingVertical: 6,
    minHeight: 58,
    zIndex: 1
  },
  tabIconWrapper: {
    marginBottom: 4
  },
  tabLabel: {
    fontSize: 10,
    fontWeight: '600',
    fontFamily: Platform.select({ ios: 'System', android: 'sans-serif-medium' }),
    marginTop: 2,
    letterSpacing: 0.2
  }
})
